CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# CT-13: stack protector in every function, and a heap that notices overruns and use after free.
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_HEAP_POISONING_COMPREHENSIVE=y

# Verified on the author's ESP32-2432S028R (docs/09-hardware-notes.md): the defaults of the backend are
# the pins and settings of the classic CYD (ILI9342C-like panel, MADCTL 0, no inversion, 40 MHz).
CONFIG_CYDUI_ESP32_PROFILE_CYD=y

# -O2: the IDF default is -Og (debug), which makes the rasterizer several times slower.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# What the CPU use of every task is measured with (NFR-04).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
